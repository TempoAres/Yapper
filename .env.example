# Copy this file to .env and replace the example values.
# Never commit your real bot token.
DISCORD_TOKEN=replace_with_your_bot_token
DISCORD_CLIENT_ID=replace_with_your_application_id

# Recommended while developing: commands registered to one test server update quickly.
# Remove this line later if you intentionally want to deploy commands globally.
DISCORD_GUILD_ID=replace_with_your_test_server_id

# Reserved for the PostgreSQL phase. It is not used by the Phase 1 bot yet.
DATABASE_URL=postgresql://yapper:change_me@localhost:5432/yapper

# Used by future weekly/monthly/yearly leaderboard calculations.
TIMEZONE=Europe/Berlin

# Phase 3 message XP settings.
XP_MIN_PER_MESSAGE=20
XP_MAX_PER_MESSAGE=30
XP_COOLDOWN_SECONDS=30
XP_DUPLICATE_WINDOW_SECONDS=120
